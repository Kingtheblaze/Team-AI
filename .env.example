# ── ChronoStream RAG Environment Variables ──
# Copy this file to .env and fill in your values.

# General
ENVIRONMENT=production
DEBUG=false

# Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu

# LLM Provider: 'fast_extractive' (default, no dependency), 'ollama', 'openai'
LLM_PROVIDER=fast_extractive

# Ollama (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.2:3b

# OpenAI (if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL_NAME=gpt-4o-mini

# Streaming
STREAM_INTERVAL_SECONDS=2.0

# Memory Bounds
MAX_MEMORY_CHUNKS=500
MAX_ACTIVE_PROTOTYPES=50
TEMPORAL_DECAY_HALF_LIFE_SEC=300.0
CHUNK_RETENTION_MINUTES=60

# Hybrid Retrieval Weights
WEIGHT_DENSE=0.50
WEIGHT_SPARSE=0.25
WEIGHT_RECENCY=0.25
